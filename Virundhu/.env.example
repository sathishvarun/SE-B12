# ============================================================
# Virundhu - environment variables
# 1. Copy this file:   cp .env.example .env
# 2. Paste your keys into .env (NOT into this file)
# 3. .env is in .gitignore, so it never goes to GitHub
# ============================================================

# ---------- App ----------
APP_ENV=development
APP_URL=http://localhost:5450
API_URL=http://localhost:8450
TIMEZONE=Asia/Kolkata

# ---------- Database / Redis (Docker runs these for you) ----------
DATABASE_URL=postgresql+psycopg2://virundhu:virundhu@localhost:5432/virundhu
REDIS_URL=redis://localhost:6379/0

# ---------- Auth ----------
# Generate with:  openssl rand -hex 32
SECRET_KEY=paste-a-random-64-character-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Super admin (created when you run the seed) ----------
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=choose-your-own-long-password
# Company inboxes (never a personal address): admin notifications and demo requests
NOTIFY_EMAIL=info@yourcompany.com
DEMO_REQUESTS_EMAIL=demo@yourcompany.com

# ---------- Demo workspace (read-only sample restaurant) ----------
DEMO_EMAIL=demo@virundhu.local
DEMO_PASSWORD=Virundhu@Demo2026

# ---------- Google sign-in (OPTIONAL: leave empty and the Google button is hidden) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8450/api/v1/auth/google/callback

# ---------- AI ----------
# Only ONE provider is used: openai or anthropic. Put the key in the matching line
# (OpenAI keys start with sk-proj / sk-, Claude keys with sk-ant-). start.sh checks this.
LLM_PROVIDER=openai

# Needed ONLY when LLM_PROVIDER=anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_TAGGING_MODEL=claude-haiku-5-5
ANTHROPIC_REPORT_MODEL=claude-sonnet-5-5

# Needed when LLM_PROVIDER=openai (platform.openai.com -> API keys)
OPENAI_API_KEY=
OPENAI_TAGGING_MODEL=gpt-4.1-mini
OPENAI_REPORT_MODEL=gpt-4.1
LLM_MAX_CONCURRENCY=8
# Estimated price per million tokens in USD, used to show AI cost per restaurant. Check your provider's pricing.
LLM_PRICE_INPUT_PER_M_USD=0.40
LLM_PRICE_OUTPUT_PER_M_USD=1.60
USD_INR=88

# ---------- Razorpay (only if PAYMENT_PROVIDER=razorpay) ----------
# dashboard.razorpay.com -> switch to Test Mode -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

# ---------- Email (leave SMTP_HOST empty = emails are printed in the log) ----------
# Google Workspace SMTP relay (no password): SMTP_HOST=smtp-relay.gmail.com, SMTP_PORT=587, leave SMTP_USER/PASSWORD empty,
# allow the server IP in Admin console > Gmail > Routing > SMTP relay, set SMTP_HELO to your site's domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Virundhu <hello@yourdomain.com>"

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8450
VITE_RAZORPAY_KEY_ID=

# ---------- Payments: dodo (default) or razorpay. Only one is used ----------
# Dodo: app.dodopayments.com -> Test Mode. API key: Developer -> API Keys.
# Product IDs (pdt_...): Products. Webhook (VPS only): Developer -> Webhooks -> /api/v1/billing/dodo-webhook
PAYMENT_PROVIDER=dodo
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# ONE "Pay What You Want" product (INR, one time, tax inclusive). The server sets the amount per checkout.
DODO_PRODUCT_FLEX=
# Highest discount code you will create in Dodo; payments below quote minus this % are refused
PROMO_MAX_DISCOUNT_PCT=20
# Launch offer shown on the billing page (create the code in Dodo -> Sales -> Discounts)
PROMO_CODE=FIRST10
PROMO_TEXT=First 10 customers get 20% off.

# ---------- WhatsApp alerts (Meta WhatsApp Cloud API) - see GETTING_STARTED.md Part 7 ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: "How you compare nearby" on the dashboard (Google Places API (New), billed per request by Google)
# Free: maps on outlet pages (Google Cloud → enable "Maps Embed API" → create an API key, restrict it to your domain)
GOOGLE_MAPS_EMBED_KEY=
GOOGLE_PLACES_API_KEY=
WHATSAPP_TEMPLATE=virundhu_alert
WHATSAPP_TEMPLATE_REVIEW=virundhu_review_request
WHATSAPP_TEMPLATE_SUMMARY=virundhu_weekly_summary
WHATSAPP_TEMPLATE_PLAN=virundhu_plan_reminder
WHATSAPP_TEMPLATE_LANG=en
