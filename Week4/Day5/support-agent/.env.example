# Copy this file to ".env" and fill in your keys

# LLM used by all agents (OpenAI by default)
OPENAI_API_KEY=sk-your-openai-key
MODEL=gpt-4o-mini

# Web search for Step 2 (free key at https://serper.dev)
SERPER_API_KEY=your-serper-key

# Optional: limit web search to your company website, e.g. example.com
COMPANY_DOMAIN=

# Don't ask to upload run traces to CrewAI
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true

# How strict the knowledge-base match is (lower = stricter). 0.0 - 2.0
RAG_MAX_DISTANCE=0.9
