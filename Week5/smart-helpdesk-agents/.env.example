# Copy this file to .env and fill in your own keys.  NEVER commit .env to GitHub.

# Required: OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: live web search for Marketing/Sales agents (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=

# Optional: use another OpenAI-compatible provider instead (Groq, Gemini, Ollama...)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional but recommended on a VPS: password to open the app
APP_PASSWORD=

# Optional: show source file names and every agent's step in the chat (demo / assignment screenshots).
# Keep false for real employees - they only see the answer.
SHOW_AGENT_STEPS=false

# Human-in-the-loop: password for the staff-only "Review queue" page (empty = page locked)
REVIEWER_PASSWORD=

# Knowledge search: "vector" = ChromaDB + OpenAI embeddings (by meaning), "keyword" = word matching
SEARCH_MODE=vector
EMBEDDING_MODEL=text-embedding-3-small
