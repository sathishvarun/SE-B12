# Copy this file to .env and fill in your own values.  NEVER commit .env to GitHub.

# ---------- AI model (required for real answers) ----------
# OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Use another OpenAI-compatible provider instead (Groq, Gemini, local Ollama):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=http://localhost:11434/v1        (Ollama — then set LLM_MODEL=qwen2.5:7b)

# "vector" = FAISS + embeddings (understands meaning, also Tamil questions)
# "keyword" = BM25 word matching (no embeddings needed)
SEARCH_MODE=vector

# Price per 1 million tokens, for the cost column in the admin dashboard (gpt-4o-mini)
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60

# ---------- Security (required) ----------
# Long random text. Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=paste-a-long-random-string-here
JWT_HOURS=12
# The first admin account is created from these on the first start
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password
# true = anyone can create a user account; false = only the admin adds people
ALLOW_SIGNUP=true

# ---------- Optional: LangSmith tracing (see every LLM call at smith.langchain.com) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bdx-insight

# ---------- Knowledge sources: answers come ONLY from these ----------
CRAWL_START_URLS=https://beldex.io/,https://beldex.io/whitepaper.pdf,https://bchat.beldex.io/,https://belnet.beldex.io/,https://browser.beldex.io/,https://bns.beldex.io/,https://beldex.io/partners,https://beldex.io/usebdx
CRAWL_ALLOWED_DOMAIN=beldex.io
CRAWL_MAX_PAGES=60
NEWS_FEEDS=https://medium.com/feed/@beldexcoin
